{
  "schemaVersion": 1,
  "upstream": {
    "repository": "https://github.com/deepseek-ai/deepseek-harness.git",
    "commit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
    "version": "0.1.1-rc.2"
  },
  "transport": "stdio-jsonrpc",
  "entrypoint": "@deepseek-ai/dsh-sdk-jsonrpc-demo/packaged-bin",
  "composition": "cordis.yml",
  "localPlugins": [
    "./agent-preset-bridge.mjs",
    "./conversation-context.mjs",
    "./request-config.mjs",
    "./tool-policy.mjs",
    "./tavily-web-search.mjs"
  ],
  "plugins": [
    "@deepseek-ai/dsh-agent-presets",
    "@deepseek-ai/dsh-agent-spine-demo",
    "@deepseek-ai/dsh-attachment-local",
    "@deepseek-ai/dsh-fs-local",
    "@deepseek-ai/dsh-llm-pi-ai",
    "@deepseek-ai/dsh-pwsh-local",
    "@deepseek-ai/dsh-sdk-jsonrpc-server",
    "@deepseek-ai/dsh-session-checkpoint-policy",
    "@deepseek-ai/dsh-session-persistence-jsonl",
    "@deepseek-ai/dsh-session-projection",
    "@deepseek-ai/dsh-shell-env",
    "@deepseek-ai/dsh-subagent",
    "@deepseek-ai/dsh-subagent-fork-in-process",
    "@deepseek-ai/dsh-subagent-spawn-in-process",
    "@deepseek-ai/dsh-subprocess-local",
    "@deepseek-ai/dsh-token-meter",
    "@deepseek-ai/dsh-tool-call-timeout-policy",
    "@deepseek-ai/dsh-user-approval",
    "@deepseek-ai/dsh-web",
    "@deepseek-ai/dsh-web-fetch-http",
    "@deepseek-ai/dsh-web-search-deepseek",
    "@deepseek-ai/dsh-workflow-worker-thread"
  ],
  "presetComposition": "agent-preset-template/agent.cordis.yml",
  "presetLocalPlugins": [
    "./roleplay-plan-tool.mjs",
    "./setting-library-tools.mjs",
    "./variable-tools.mjs"
  ],
  "presetPlugins": [
    "@deepseek-ai/dsh-agent-instructions",
    "@deepseek-ai/dsh-compaction-basic",
    "@deepseek-ai/dsh-fs-observation-policy",
    "@deepseek-ai/dsh-tool-fs",
    "@deepseek-ai/dsh-tool-pwsh",
    "@deepseek-ai/dsh-tool-subagent",
    "@deepseek-ai/dsh-tool-subagent-control",
    "@deepseek-ai/dsh-tool-subagent-control/list-agents",
    "@deepseek-ai/dsh-tool-subagent-report",
    "@deepseek-ai/dsh-tool-todo",
    "@deepseek-ai/dsh-tool-web",
    "@deepseek-ai/dsh-tool-workflow"
  ],
  "capabilities": {
    "streaming": true,
    "durableSessions": true,
    "powershell": true,
    "filesystem": true,
    "skills": true,
    "jobs": true,
    "goals": true,
    "subagents": true,
    "workflows": true,
    "compaction": true,
    "variables": true,
    "settingLibrary": true,
    "conversationContext": true,
    "approvalAudit": true,
    "imageInput": true,
    "agentPresets": true,
    "webSearch": true,
    "webFetch": true
  }
}
