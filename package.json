{
  "name": "eleckoi-desktop",
  "version": "0.1.0",
  "description": "ElecKoi offline-first AI desktop client",
  "author": "ElecKoi",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/eleckoi/ElecKoi.git"
  },
  "homepage": "https://github.com/eleckoi/ElecKoi",
  "private": true,
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "build:workspace-runtime": "pnpm --filter @eleckoi/author-sdk build && pnpm --filter @eleckoi/compatibility-mvu build && pnpm --filter @eleckoi/dsh-runtime build",
    "postinstall": "pnpm build:workspace-runtime",
    "rebuild:electron": "electron-rebuild --force --only better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "check:electron-sqlite": "node scripts/check-electron-sqlite.mjs",
    "check:electron-dsh": "node scripts/check-electron-dsh-runtime.mjs",
    "verify:packaged-dsh": "node scripts/verify-packaged-dsh-runtime.mjs",
    "build:native-frame": "node scripts/build-windows-native-frame.mjs",
    "predev": "pnpm rebuild:electron && pnpm build:native-frame",
    "dev": "electron-vite dev",
    "build": "pnpm check:architecture && pnpm check:database-schema && pnpm check:dsh-versions && pnpm check:dsh-runtime && pnpm check:licenses && pnpm typecheck && electron-vite build && node scripts/check-built-preload.mjs && pnpm build:native-frame",
    "build:unpack": "pnpm build && pnpm rebuild:electron && pnpm check:electron-sqlite && pnpm check:electron-dsh && electron-builder --dir && pnpm verify:packaged-dsh",
    "build:win": "pnpm build && pnpm rebuild:electron && pnpm check:electron-sqlite && pnpm check:electron-dsh && electron-builder --win --x64 && pnpm verify:packaged-dsh",
    "prepreview": "pnpm rebuild:electron",
    "preview": "electron-vite preview",
    "pretypecheck": "pnpm build:workspace-runtime",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "pretest": "pnpm build:workspace-runtime && pnpm rebuild:node",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dsh-versions": "node scripts/check-dsh-versions.mjs",
    "check:dsh-runtime": "node scripts/check-dsh-runtime.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "check:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "db:generate": "node scripts/generate-common-schema.mjs",
    "check:database-schema": "node scripts/generate-common-schema.mjs --check"
  },
