{
  "name": "@eleckoi/dsh-web-search-tavily",
  "version": "0.1.0",
  "description": "ElecKoi Tavily search provider for the DSH web capability",
  "private": true,
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "dsh.web.search-provider:tavily",
        "kind": "contribution",
        "title": "Tavily 搜索提供器",
        "description": "向 DSH Web 注册 Tavily 联网搜索实现。",
        "mode": "register",
        "scope": "host",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-web",
        "members": [
          "registerSearchProvider"
        ]
      }
    ]
  }
}
