{
  "masterImport": "<h3 data-i18n=\"Choose what to import\">\n    Choose what to import\n</h3>\n<div class=\"flex-container flexFlowColumn justifyLeft\">\n    {{#each sections}}\n        {{#with this}}\n            <label class=\"checkbox_label\">\n                <input type=\"checkbox\" value=\"{{key}}\" checked>\n                <span data-i18n=\"{{name}}\">{{name}}</span>\n                {{#if preset}}\n                    <span>&ndash;</span>\n                    <small>{{preset}}</small>\n                {{/if}}\n            </label>\n        {{/with}}\n    {{/each}}\n</div>\n",
  "masterExport": "<h3 data-i18n=\"Choose what to export\">\n    Choose what to export\n</h3>\n<div class=\"flex-container flexFlowColumn justifyLeft\">\n    {{#each sections}}\n        {{#with this}}\n            <label class=\"checkbox_label\">\n                {{#if checked}}\n                    <input type=\"checkbox\" value=\"{{key}}\" checked />\n                {{else}}\n                    <input type=\"checkbox\" value=\"{{key}}\" />\n                {{/if}}\n                <span data-i18n=\"{{name}}\">{{name}}</span>\n            </label>\n        {{/with}}\n    {{/each}}\n</div>\n"
}
