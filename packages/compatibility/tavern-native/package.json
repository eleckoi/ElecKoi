{
  "name": "@eleckoi/tavern-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Tavern public interfaces backed by ElecKoi native product services.",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./install": {
      "types": "./src/index.d.ts",
      "default": "./src/install.js"
    },
    "./runtime": "./src/runtime.js",
    "./browser/*": "./dist/*",
    "./package.json": "./package.json",
    "./tokenizers": {
      "types": "./src/tokenizer-service.d.ts",
      "default": "./src/tokenizer-service.js"
    }
  },
  "files": [
    "src",
    "dist",
    "SCHEMA_VALIDATION_NOTICES.md",
    "TOKENIZER_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@adobe/css-tools": "4.4.4",
    "@iconfu/svg-inject": "1.2.3",
    "@mozilla/readability": "0.6.0",
    "@popperjs/core": "2.11.8",
    "bowser": "2.12.1",
    "chalk": "5.6.0",
    "chevrotain": "11.2.0",
    "diff-match-patch": "1.0.5",
    "dompurify": "3.4.2",
    "droll": "0.2.1",
    "fflate": "0.8.2",
    "fuse.js": "7.1.0",
    "handlebars": "4.7.9",
    "highlight.js": "11.11.1",
    "js-sha256": "0.11.1",
    "localforage": "1.10.0",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "morphdom": "2.7.7",
    "seedrandom": "3.0.5",
    "showdown": "2.1.0",
    "slidetoggle": "4.0.0",
    "yaml": "2.9.0",
    "esbuild": "0.25.10"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.1.11",
    "@agnai/web-tokenizers": "0.1.6-pre3",
    "js-tiktoken": "1.0.21"
  }
}
