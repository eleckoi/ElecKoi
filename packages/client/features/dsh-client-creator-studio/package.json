{
  "name": "@eleckoi/dsh-client-creator-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./agent": "./src/host/agent.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@eleckoi/dsh-product-api",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "提供 AI 创作工作室会话、角色编辑能力与项目目录。",
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiCreatorStudio",
        "kind": "service",
        "title": "创作项目服务",
        "description": "读取、创建、删除创作项目并订阅项目列表变化。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "create",
          "delete",
          "selectDirectory"
        ]
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@eleckoi/dsh-product-api": "workspace:*",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@eleckoi/dsh-product-data": "workspace:*",
    "@eleckoi/dsh-client-roleplay": "workspace:*",
    "zod": "4.1.11"
  }
}
