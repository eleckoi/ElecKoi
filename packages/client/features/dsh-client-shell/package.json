{
  "name": "@eleckoi/dsh-client-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@eleckoi/dsh-client-characters",
        "@eleckoi/dsh-client-character-configuration",
        "@eleckoi/dsh-client-conversations",
        "@eleckoi/dsh-client-creator-studio",
        "@eleckoi/dsh-client-display-preferences",
        "@eleckoi/dsh-client-models",
        "@eleckoi/dsh-client-persona",
        "@eleckoi/dsh-client-presets",
        "@eleckoi/dsh-client-web-search",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "提供主窗口、导航、设置和插件中心。",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoi.shell.window",
        "kind": "ui-slot",
        "title": "窗口呈现",
        "description": "按运行平台装配窗口页面，保留共享 Client 业务服务和导航合同。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "layout",
        "kind": "service",
        "title": "桌面布局服务",
        "description": "切换主面板并控制桌面导航和侧栏。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "selectPanel",
          "beginNavigation",
          "toggleSidebar",
          "openRightbar",
          "closeRightbar"
        ]
      },
      {
        "id": "sidebar.brand.mark",
        "kind": "contribution",
        "title": "品牌图标",
        "description": "向官方侧边栏提供品牌图标。",
        "mode": "replace",
        "scope": "root",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-client-ui-sidebar"
      },
      {
        "id": "sidebar.brand.name",
        "kind": "contribution",
        "title": "品牌名称",
        "description": "向官方侧边栏提供品牌名称。",
        "mode": "replace",
        "scope": "root",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-client-ui-sidebar"
      },
      {
        "id": "sidebar.panellist",
        "kind": "contribution",
        "title": "导航入口",
        "description": "向侧边栏增加主导航入口。",
        "mode": "append",
        "scope": "root",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-client-ui-sidebar"
      },
      {
        "id": "sidebar.panellist.actions",
        "kind": "contribution",
        "title": "更多菜单工作区入口",
        "description": "向官方更多菜单增加进入工作区界面的操作。",
        "mode": "append",
        "scope": "root",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-client-ui-sidebar"
      },
      {
        "id": "sidebar",
        "kind": "ui-slot",
        "title": "侧边栏",
        "description": "替换桌面侧边栏。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "main",
        "kind": "ui-slot",
        "title": "主面板",
        "description": "按面板键注册桌面主页面。",
        "mode": "register",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "rightbar",
        "kind": "ui-slot",
        "title": "右侧面板",
        "description": "提供桌面右侧面板。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "shell.overlay",
        "kind": "ui-slot",
        "title": "全局浮层",
        "description": "在桌面界面上方增加浮层。",
        "mode": "append",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "shell.leading",
        "kind": "ui-slot",
        "title": "窗口前置区域",
        "description": "提供桌面窗口前置内容。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "settings.section",
        "kind": "ui-slot",
        "title": "设置分区",
        "description": "向设置页增加分区。",
        "mode": "append",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay",
        "kind": "ui-slot",
        "title": "角色聊天页面",
        "description": "包装或替换角色聊天页面。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.creator-studio.conversation",
        "kind": "ui-slot",
        "title": "AI 创作工作室对话",
        "description": "以独立工作室会话呈现官方对话和工具流程。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1"
  }
}
