{
  "name": "@eleckoi/dsh-client-models",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "通过 DSH Settings、Credentials 和 Remote 管理模型配置并提供模型选择。",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiModels",
        "kind": "service",
        "title": "模型目录服务",
        "description": "读取模型目录、管理独立提供商配置和密钥，以及读取模型。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "save",
          "saveModelParameters",
          "deleteConfig",
          "discover",
          "revealApiKey",
          "sessionParameters",
          "readSessionModelParameters",
          "saveSessionModelParameters"
        ]
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@eleckoi/dsh-product-api": "workspace:*",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0"
  }
}
