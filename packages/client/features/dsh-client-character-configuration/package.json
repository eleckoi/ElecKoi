{
  "name": "@eleckoi/dsh-client-character-configuration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "读取、保存并更新设定库、变量、正则和分支设定。",
  "engines": {
    "dsh": "0.2.0-rc.2"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiSettingLibraries",
        "kind": "service",
        "title": "设定库服务",
        "description": "读取、保存和订阅全局、角色设定库及对话设定。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getGlobalSnapshot",
          "subscribeGlobal",
          "readGlobal",
          "saveGlobal",
          "saveGlobalViewState",
          "getSnapshot",
          "subscribe",
          "read",
          "readUntracked",
          "save",
          "saveViewState",
          "getConversationSnapshot",
          "readConversations",
          "saveConversation",
          "resetConversation",
          "saveConversationVersion"
        ]
      },
      {
        "id": "eleckoiVariables",
        "kind": "service",
        "title": "角色变量服务",
        "description": "读取、保存和订阅角色变量配置。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "read",
          "readUntracked",
          "save",
          "saveViewState"
        ]
      },
      {
        "id": "eleckoiScriptLibraries",
        "kind": "service",
        "title": "脚本库服务",
        "description": "按全局、角色和当前预设归属读取、保存与订阅正式脚本库。",
        "mode": "call-and-listen",
        "scope": "client",
        "relation": "provides",
          "members": ["getSnapshot", "read", "save", "saveAll", "subscribe", "subscribeChanges", "activePreset", "openDirectory"]
      },
      {
        "id": "eleckoiRegexRules",
        "kind": "service",
        "title": "角色正则服务",
        "description": "读取、保存、导入、导出并测试角色正则。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "read",
          "readUntracked",
          "save",
          "import",
          "export",
          "test"
        ]
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@eleckoi/dsh-product-api": "workspace:*"
  }
}
