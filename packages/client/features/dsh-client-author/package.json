{
  "name": "@eleckoi/dsh-client-author",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/client.js" },
    "./runtime": "./lib/types/runtime.js",
    "./audio": "./lib/types/audio.js",
    "./frontends": "./lib/types/frontends.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@eleckoi/author-sdk": "workspace:*",
    "@eleckoi/tavern-native": "workspace:*",
    "@eleckoi/dsh-product-api": "workspace:*",
    "@eleckoi/dsh-client-conversations": "workspace:*",
    "@eleckoi/dsh-client-models": "workspace:*",
    "@eleckoi/dsh-client-characters": "workspace:*",
    "@eleckoi/dsh-client-persona": "workspace:*",
    "@eleckoi/dsh-client-presets": "workspace:*",
    "@eleckoi/dsh-client-character-configuration": "workspace:*"
  },
  "scripts": { "build": "tsc -b tsconfig.client.json && tsdown" },
  "devDependencies": { "tsdown": "0.16.6", "typescript": "5.9.3" },
  "engines": { "dsh": "0.2.0-rc.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@eleckoi/dsh-product-api", "@eleckoi/dsh-client-conversations", "@eleckoi/dsh-client-character-configuration", "@eleckoi/dsh-client-models", "@eleckoi/dsh-client-characters", "@eleckoi/dsh-client-persona", "@eleckoi/dsh-client-presets"] }
  },
  "eleckoi": {
    "developerInterfaces": [{
      "id": "eleckoiAuthorRuntime", "kind": "service", "title": "原生作者运行环境",
      "description": "启动正式脚本库中的原生程序，处理变量规则并绑定当前聊天的作者页面与输入框。",
      "mode": "call", "scope": "client", "relation": "provides",
      "members": ["getSnapshot", "subscribe", "getUiSnapshot", "subscribeUi", "invokeButton", "dismissPanel", "mountScriptPanelDocument", "registerChatUi", "mountDocument", "mountProjectDocument"]
    }, {
      "id": "eleckoiFrontendProjects", "kind": "service", "title": "原生前端项目",
      "description": "通过正式 Remote 管理应用和角色文件项目，按明确归属订阅最新工作区。",
      "mode": "call", "scope": "client", "relation": "provides", "members": ["watch"]
    }]
  }
}
