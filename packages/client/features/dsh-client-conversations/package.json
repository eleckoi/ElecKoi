{
  "name": "@eleckoi/dsh-client-conversations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@eleckoi/dsh-client-character-configuration",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-stats": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@eleckoi/dsh-client-character-configuration": "workspace:*",
    "@eleckoi/dsh-product-api": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.2.2-rc.1"
  },
  "description": "管理聊天列表、历史消息和当前聊天状态。",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiConversations",
        "kind": "service",
        "title": "聊天记录服务",
        "description": "读取聊天列表、消息、轨迹和当前生成状态。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "getDetailsSnapshot",
          "getSessionReference",
          "subscribeDetails",
          "getStatsSnapshot",
          "subscribeStats",
          "getChatSnapshot",
          "subscribeChat",
          "getTimelineSnapshot",
          "subscribeTimeline",
          "getStreamSnapshot",
          "readImage",
          "regenerateImage",
          "subscribeStream",
          "subscribeGeneration",
          "getGenerationReply",
          "refresh",
          "create",
          "open",
          "pageOlder",
          "observeRequestPreviews",
          "readRequestPreview",
          "openTimeline",
          "closeTimeline",
          "uploadFile",
          "readInputDraft",
          "writeInputDraft",
          "submitInput",
          "prepareNativeInput",
          "send",
          "regenerate",
          "cancelRequest",
          "cancelGeneration",
          "readSelection",
          "saveSelection",
          "readModelSelection",
          "readTrajectory",
          "exportArchive",
          "importArchive",
          "revealFile",
          "selectModel",
          "selectOpening",
          "updateOpening",
          "rememberSession",
          "preferredSession",
          "forgetSession",
          "readAuthorState",
          "replaceAuthorVariableState",
          "editMessage",
          "deleteMessagesFrom",
          "delete",
          "getModelSelectionSnapshot",
          "subscribeModelSelection"
        ]
      },
      {
        "id": "eleckoi.conversation.list",
        "kind": "ui-slot",
        "title": "聊天列表",
        "description": "包装或替换聊天列表。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      }
    ]
  }
}
