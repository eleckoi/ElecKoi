{
  "name": "@eleckoi/dsh-client-characters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "展示角色列表和资料，提供角色操作入口。",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiCharacters",
        "kind": "service",
        "title": "角色目录服务",
        "description": "读取并维护角色目录，支持角色复制、分组、导入与导出操作。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "create",
          "duplicate",
          "update",
          "select",
          "saveGroups",
          "delete",
          "prepareImport",
          "commitImport",
          "discardImport",
          "exportCharacters"
        ]
      },
      {
        "id": "eleckoi.character.page.list",
        "kind": "ui-slot",
        "title": "角色列表区域",
        "description": "包装或替换角色列表。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.page.profile",
        "kind": "ui-slot",
        "title": "角色资料区域",
        "description": "包装或替换角色资料展示。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.card",
        "kind": "ui-slot",
        "title": "角色基础资料编辑",
        "description": "扩展角色名称、头像和基础资料编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.openings",
        "kind": "ui-slot",
        "title": "角色开场白编辑",
        "description": "扩展主开场白、备用开场白和变量版本绑定编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.lore",
        "kind": "ui-slot",
        "title": "设定库编辑",
        "description": "扩展角色设定库编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.variables",
        "kind": "ui-slot",
        "title": "变量编辑",
        "description": "扩展角色变量编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.regex",
        "kind": "ui-slot",
        "title": "正则编辑",
        "description": "扩展角色正则规则编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.scripts",
        "kind": "ui-slot",
        "title": "脚本库编辑",
        "description": "扩展角色配置中的全局、角色和当前预设脚本编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.frontend",
        "kind": "ui-slot",
        "title": "角色前端编辑",
        "description": "扩展角色配置中的前端文件项目导入、编辑、预览和启用。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.dynamic",
        "kind": "ui-slot",
        "title": "分支设定编辑",
        "description": "扩展分支设定编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.manager",
        "kind": "ui-slot",
        "title": "角色卡管理器",
        "description": "包装或替换角色卡导入、导出和批量管理界面。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@eleckoi/dsh-product-api": "workspace:*"
  }
}
