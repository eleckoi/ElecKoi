{
  "name": "@eleckoi/dsh-client-characters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "展示角色列表和资料，提供角色操作入口。",
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoi.character.editor.assets",
        "kind": "ui-slot",
        "title": "角色素材库",
        "description": "包装或替换角色卡内的素材库。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.navigation",
        "kind": "ui-slot",
        "title": "角色编辑器导航",
        "description": "包装或替换角色编辑器的分区导航。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.toolbar",
        "kind": "ui-slot",
        "title": "角色编辑器工具栏",
        "description": "包装或替换角色编辑器顶部工具栏。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.list",
        "kind": "ui-slot",
        "title": "安卓角色库列表",
        "description": "包装或替换安卓角色库的瀑布流。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.item",
        "kind": "ui-slot",
        "title": "单张角色卡",
        "description": "包装或替换列表中的角色行或卡片。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.search",
        "kind": "ui-slot",
        "title": "角色搜索控件",
        "description": "扩展角色列表或管理器的搜索控件。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.sort",
        "kind": "ui-slot",
        "title": "角色排序控件",
        "description": "扩展原有角色排序菜单及触发按钮。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.groups",
        "kind": "ui-slot",
        "title": "角色分组",
        "description": "扩展角色列表及管理器的分组控件。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.selection",
        "kind": "ui-slot",
        "title": "角色批量工具栏",
        "description": "扩展选中多张角色卡时的操作控件。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.menu.actions",
        "kind": "ui-slot",
        "title": "角色库操作菜单",
        "description": "向角色库的新建、导入、排序或批量操作菜单追加菜单项。",
        "mode": "append",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.item.menu.actions",
        "kind": "ui-slot",
        "title": "单张角色卡菜单",
        "description": "向当前角色的操作菜单追加菜单项。",
        "mode": "append",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.library.group.menu.actions",
        "kind": "ui-slot",
        "title": "角色分组菜单",
        "description": "向角色分组右键菜单追加菜单项。",
        "mode": "append",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoiCharacters",
        "kind": "service",
        "title": "角色目录服务",
        "description": "读取并维护角色目录，支持角色复制、分组、导入与导出操作。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "create",
          "duplicate",
          "update",
          "select",
          "saveGroups",
          "delete",
          "prepareImport",
          "commitImport",
          "discardImport",
          "exportCharacters"
        ]
      },
      {
        "id": "eleckoi.character.page.list",
        "kind": "ui-slot",
        "title": "角色列表区域",
        "description": "包装或替换角色列表。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.page.profile",
        "kind": "ui-slot",
        "title": "角色资料区域",
        "description": "包装或替换角色资料展示。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.card",
        "kind": "ui-slot",
        "title": "角色基础资料编辑",
        "description": "扩展角色名称、头像和基础资料编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.openings",
        "kind": "ui-slot",
        "title": "角色开场白编辑",
        "description": "扩展主开场白、备用开场白和变量版本绑定编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.lore",
        "kind": "ui-slot",
        "title": "设定库编辑",
        "description": "扩展角色设定库编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.variables",
        "kind": "ui-slot",
        "title": "变量编辑",
        "description": "扩展角色变量编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.regex",
        "kind": "ui-slot",
        "title": "正则编辑",
        "description": "扩展角色正则规则编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.scripts",
        "kind": "ui-slot",
        "title": "脚本库编辑",
        "description": "扩展角色配置中的全局、角色和当前预设脚本编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.frontend",
        "kind": "ui-slot",
        "title": "角色前端编辑",
        "description": "扩展角色配置中的前端文件项目导入、编辑、预览和启用。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.editor.dynamic",
        "kind": "ui-slot",
        "title": "分支设定编辑",
        "description": "扩展分支设定编辑。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      },
      {
        "id": "eleckoi.character.manager",
        "kind": "ui-slot",
        "title": "角色卡管理器",
        "description": "包装或替换角色卡导入、导出和批量管理界面。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@eleckoi/dsh-product-api": "workspace:*"
  }
}
