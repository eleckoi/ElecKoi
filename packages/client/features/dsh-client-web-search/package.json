{
  "name": "@eleckoi/dsh-client-web-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./profile": {
      "types": "./src/profile.d.ts",
      "default": "./src/profile.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "通过 DSH Settings、Credentials 与 Remote 管理联网搜索配置。",
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiWebSearch",
        "kind": "service",
        "title": "联网搜索设置服务",
        "description": "选择官方搜索与抓取方式，跳转官方网页搜索插件设置，并管理 Tavily 配置和凭据。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "update",
          "saveAndTest",
          "test",
          "removeKey",
          "openPluginSettings"
        ]
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@eleckoi/dsh-product-api": "workspace:*",
    "yaml": "2.9.0",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5"
  }
}
