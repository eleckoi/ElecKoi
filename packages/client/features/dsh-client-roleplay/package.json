{
  "name": "@eleckoi/dsh-client-roleplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": "./src/client.js",
    "./host/*": "./src/host/*",
    "./host-types": {
      "types": "./src/host/types.ts"
    },
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./projections": {
      "types": "./src/projections.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.5",
    "@deepseek-ai/dsh-spill-local": "0.2.1-rc.5",
    "@eleckoi/dsh-product-data": "workspace:*",
    "yaml": "2.9.0",
    "zod": "4.1.11"
  },
  "description": "提供角色聊天界面，并将角色配置接入 DSH 对话运行。",
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoi.roleplay.chat",
        "kind": "ui-slot",
        "title": "角色对话视图",
        "description": "以官方 ChatView 承接角色消息座位、历史分页、导航与阅读位置。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.chat.node",
        "kind": "ui-slot",
        "title": "角色对话节点",
        "description": "按正式 ChatNodeKind 替换角色对话的节点呈现。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.chat.images",
        "kind": "ui-slot",
        "title": "角色对话图片",
        "description": "呈现角色对话中使用正式授权加载器读取的消息图片。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.chat.before",
        "kind": "ui-slot",
        "title": "角色对话开场区域",
        "description": "呈现 Session 消息之前的产品开场内容，不创建 Session 事件。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.chat.pending-input",
        "kind": "ui-slot",
        "title": "角色对话发送回显",
        "description": "呈现官方等待正式 Session 消息接替的输入回显。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.message.content",
        "kind": "ui-slot",
        "title": "消息正文",
        "description": "包装或替换角色聊天消息正文。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.message.actions",
        "kind": "ui-slot",
        "title": "消息操作",
        "description": "在消息旁增加操作。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.message.after",
        "kind": "ui-slot",
        "title": "消息下方",
        "description": "在消息下方增加内容。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.header.corner",
        "kind": "ui-slot",
        "title": "对话标题栏角落",
        "description": "在新建对话按钮右侧承接官方会话标题栏角落控件。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.composer.bar",
        "kind": "ui-slot",
        "title": "整体输入框",
        "description": "替换当前官方输入框，可读取扮演菜单、模型选择器和统计区的装配参数。",
        "mode": "replace",
        "scope": "session-maybe",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.composer",
        "kind": "ui-slot",
        "title": "输入区临时接管",
        "description": "按当前会话的审批或计划等状态临时接管输入区，释放后恢复原输入框。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.left",
        "kind": "ui-slot",
        "title": "输入框左侧",
        "description": "在当前官方输入框的左侧工具区追加控件。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.right",
        "kind": "ui-slot",
        "title": "输入框右侧",
        "description": "在当前官方输入框的模型选择器附近追加控件。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.overlay",
        "kind": "ui-slot",
        "title": "输入框浮层",
        "description": "在当前官方输入框内追加浮层。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.dock",
        "kind": "ui-slot",
        "title": "输入框上方",
        "description": "在输入框上方追加内容，并读取当前会话和输入状态。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.attachments",
        "kind": "ui-slot",
        "title": "附件展示",
        "description": "替换原生文件和图片附件的展示，继续使用官方添加、移除和上传重试操作。",
        "mode": "replace",
        "scope": "session-maybe",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.permission",
        "kind": "ui-slot",
        "title": "权限控件",
        "description": "替换输入框中的权限控件。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.plan",
        "kind": "ui-slot",
        "title": "计划控件",
        "description": "替换输入框中的计划模式控件。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.model",
        "kind": "ui-slot",
        "title": "输入框皮肤模型位",
        "description": "供输入框皮肤调用的模型控件位置；默认输入框使用 ElecKoi 模型选择器。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.model.label",
        "kind": "ui-slot",
        "title": "模型名称与标签",
        "description": "在模型入口、当前模型及选项中复用官方模型名称扩展，只显示名称与标签。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.input.activity",
        "kind": "ui-slot",
        "title": "输入框活动区",
        "description": "替换输入框右侧活动区，展开时占用工具栏空间。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.composer.dock",
        "kind": "ui-slot",
        "title": "输入框下方",
        "description": "在输入框下方的产品统计区域追加内容；默认官方统计不重复显示。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.approval.detail",
        "kind": "ui-slot",
        "title": "审批详情",
        "description": "在输入区被审批组件接管时替换审批详情。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.conversation.plan-review.actions",
        "kind": "ui-slot",
        "title": "计划审核操作",
        "description": "在输入区被计划审核组件接管时追加操作。",
        "mode": "append",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.trajectory.images",
        "kind": "ui-slot",
        "title": "轨迹图片预览",
        "description": "提供轨迹详情中的图片预览。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.trajectory",
        "kind": "ui-slot",
        "title": "角色聊天轨迹",
        "description": "替换角色聊天轨迹视图，读取正式 Session 轨迹。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.chat.frontend",
        "kind": "ui-slot",
        "title": "角色聊天前端",
        "description": "包装角色前端或默认聊天内容区，不替换现有输入框和会话操作。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoiRequestPreviews",
        "kind": "service",
        "title": "运行期间请求预览",
        "description": "在实际发送位置捕获请求，运行期间共用未变化的消息内容；不写入日志、数据库或投影缓存。",
        "mode": "call",
        "scope": "host",
        "relation": "provides",
        "members": [
          "capture",
          "list",
          "read",
          "stream",
          "forget",
          "close"
        ],
        "owner": "eleckoiRequestPreviews"
      },
      {
        "id": "eleckoi.roleplay.chat.flow",
        "kind": "ui-slot",
        "title": "角色聊天正文流程",
        "description": "角色聊天正文流程，复用官方会话渲染入口。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      },
      {
        "id": "eleckoi.roleplay.chat.user.images",
        "kind": "ui-slot",
        "title": "角色聊天用户图片",
        "description": "角色聊天用户图片，复用官方会话渲染入口。",
        "mode": "replace",
        "scope": "session",
        "relation": "provides"
      }
    ]
  }
}
