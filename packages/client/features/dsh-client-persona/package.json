{
  "name": "@eleckoi/dsh-client-persona",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "管理用户名称、头像和角色扮演身份。",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiPersona",
        "kind": "service",
        "title": "用户资料服务",
        "description": "读取用户资料、订阅变化并主动刷新。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "save"
        ]
      },
      {
        "id": "eleckoi.persona.editor",
        "kind": "ui-slot",
        "title": "用户资料编辑",
        "description": "包装或替换用户资料编辑器。",
        "mode": "replace",
        "scope": "root",
        "relation": "provides"
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@eleckoi/dsh-product-api": "workspace:*"
  }
}
