{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@eleckoi/tavern-frontend": [
        "./packages/compatibility/tavern-frontend/dist/index.d.ts"
      ],
      "@eleckoi/dsh-product-data/frontends": [
        "./packages/host/product-data/src/domain/frontends/index.ts"
      ],
      "@eleckoi/dsh-product-data": [
        "./packages/host/product-data/src/index.ts"
      ],
      "@eleckoi/dsh-product-data/media": [
        "./packages/host/product-data/src/storage/media/index.ts"
      ],
      "@eleckoi/dsh-product-data/variables": [
        "./packages/host/product-data/src/domain/variables/variableSchema.ts"
      ],
      "@main/*": [
        "./apps/desktop/src/main/*"
      ],
      "@product-data/*": [
        "./packages/host/product-data/src/*"
      ],
      "@shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "apps/android-host/src/androidPluginBundles.ts",
    "apps/android-host/src/androidPluginRecovery.ts",
    "apps/android-host/src/pluginHostConfiguration.ts",
    "apps/android-host/src/androidPluginBundleManifest.json",
    "apps/desktop/electron.vite.config.ts",
    "scripts/vite-author-vendor-plugin.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/windowsLayout.ts",
    "apps/desktop/src/preload/**/*.ts",
    "apps/desktop-host/src/childHostFailure.ts",
    "apps/desktop-host/src/hostSessionProtocol.ts",
    "packages/shared/src/**/*.ts",
    "packages/host/product-data/src/**/*.ts",
    "packages/host/product-api/src/hostInspect.ts",
    "packages/host/product-api/src/inspectProvider.ts",
    "packages/host/product-api/src/tool-provenance.ts",
    "packages/host/product-api/src/cordisApi.generated.ts",
    "packages/host/product-api/src/client/inspect.ts",
    "packages/host/product-api/src/errorCodes.generated.ts",
    "packages/host/product-api/src/productFailure.ts",
    "packages/host/product-api/src/client/invalidResponse.ts",
    "packages/host/product-api/src/client/unwrapFailure.ts",
    "packages/host/product-api/src/client/cordisApi.generated.ts",
    "packages/host/product-api/src/client/remoteApi.generated.ts",
    "packages/client/features/dsh-client-author/src/generation.ts",
    "packages/client/features/dsh-client-author/src/messages.ts",
    "packages/client/features/dsh-client-author/src/editor-versions.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "apps/*/tests/**/*.ts",
    "packages/**/tests/**/*.ts"
  ]
}
