{
  "schemaVersion": 1,
  "upstream": {
    "repository": "https://github.com/deepseek-ai/deepseek-harness.git",
    "commit": "c1b47e41fcd54d20a0f061df28683bfc29ee24e5",
    "version": "0.2.0-rc.2"
  },
  "transport": "authenticated-web-host",
  "entrypoint": "@deepseek-ai/dsh/package.json",
  "composition": "cordis.yml",
  "compositionRole": "sdk-compatibility",
  "desktopProfile": {
    "name": "desktop",
    "base": "web",
    "agentPatch": "desktop-agent.patch.yml",
    "bundles": [
      "@eleckoi/dsh-client-characters",
      "@eleckoi/dsh-client-character-configuration",
      "@eleckoi/dsh-client-conversations",
      "@eleckoi/dsh-client-creator-studio",
      "@eleckoi/dsh-client-display-preferences",
      "@eleckoi/dsh-client-models",
      "@eleckoi/dsh-client-persona",
      "@eleckoi/dsh-client-presets",
      "@eleckoi/dsh-client-web-search",
      "@eleckoi/dsh-client-shell",
      "@eleckoi/dsh-client-roleplay",
      "@eleckoi/dsh-client-tavern-shared",
      "@eleckoi/dsh-compatibility-host",
      "@eleckoi/dsh-product-api",
      "@eleckoi/dsh-runtime",
      "@eleckoi/dsh-web-search-tavily"
    ]
  },
  "localPlugins": [
    "./agent-preset-bridge.mjs",
    "./tavily-web-search.mjs"
  ],
  "localModules": [
    "./conversation-context.mjs",
    "./request-config.mjs",
    "./session-snapshot.mjs",
    "./tool-policy.mjs"
  ],
  "plugins": [
    "@deepseek-ai/dsh-agent-preset-registry"
  ],
  "presetComposition": "agent-preset-template/agent.cordis.yml",
  "presetLocalPlugins": [
    "./uploaded-file-tools.mjs",
    "./roleplay-plan-tool.mjs",
    "./setting-library-tools.mjs",
    "./variable-tools.mjs"
  ],
  "presetPlugins": [
    "@deepseek-ai/dsh-agent-instructions",
    "@deepseek-ai/dsh-command-compact",
    "@deepseek-ai/dsh-compaction-basic",
    "@deepseek-ai/dsh-compaction-tool-result-pruner",
    "@deepseek-ai/dsh-fs-observation-policy",
    "@deepseek-ai/dsh-skill-filesystem",
    "@deepseek-ai/dsh-tool-fs",
    "@deepseek-ai/dsh-tool-goal",
    "@deepseek-ai/dsh-tool-jobs",
    "@deepseek-ai/dsh-tool-pwsh",
    "@deepseek-ai/dsh-tool-skill",
    "@deepseek-ai/dsh-tool-subagent",
    "@deepseek-ai/dsh-tool-subagent-control",
    "@deepseek-ai/dsh-tool-subagent-control/list-agents",
    "@deepseek-ai/dsh-tool-todo",
    "@deepseek-ai/dsh-tool-web",
    "@deepseek-ai/dsh-tool-workflow",
    "@deepseek-ai/dsh-workflow-ptc"
  ],
  "capabilities": {
    "streaming": true,
    "durableSessions": true,
    "powershell": true,
    "filesystem": true,
    "skills": true,
    "jobs": true,
    "goals": true,
    "subagents": true,
    "workflows": true,
    "compaction": true,
    "variables": true,
    "settingLibrary": true,
    "conversationContext": true,
    "approvalAudit": true,
    "imageInput": true,
    "agentPresets": true,
    "webSearch": true,
    "webFetch": true
  }
}
