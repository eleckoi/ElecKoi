{
  "name": "@eleckoi/desktop-host",
  "version": "0.2.15",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./host": "./dist/host.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
