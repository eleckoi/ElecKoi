+/*
+ * Termux bakes its private prefix into _PATH_TMP. ElecKoi runs this library
+ * from its own application sandbox, whose absolute path can also vary by
+ * Android user. Resolve the writable directory at runtime instead of binding
+ * the ELF to another application's package name.
+ */
+static int format_ashv_key_symlink_path(char *buffer, size_t buffer_size, key_t key)
+{
+	const char *directory = getenv("ELECKOI_SHMEM_DIR");
+	if (directory == NULL || directory[0] == '\0') directory = getenv("PROOT_TMP_DIR");
+	if (directory == NULL || directory[0] == '\0') directory = getenv("TMPDIR");
+	if (directory == NULL || directory[0] == '\0') {
+		errno = ENOENT;
+		return -1;
+	}
+
+	size_t directory_length = strlen(directory);
+	const char *separator = directory_length > 0 && directory[directory_length - 1] == '/' ? "" : "/";
+	return snprintf(buffer, buffer_size, "%s%sashv_key_%d", directory, separator, key);
+}
